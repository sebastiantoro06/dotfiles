# --- Secrets & machine-local overrides ---
# Never commit real secrets/tokens or machine-specific local overrides.
*.local
*.local.*
.env
.env.*
!.env.example
*_history
.netrc
id_rsa
id_ed25519
*.pem
*.key

# --- Backups made by install scripts ---
*.bak
*.orig
*.backup

# --- Package manager / tool cruft that sometimes leaks in ---
node_modules/
